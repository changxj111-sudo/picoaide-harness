+const FALLBACK_PRODUCT_NAME = "PicoAide Harness";
+/** Resolve the product/OEM name composed into the running desktop profile. */
+function productName(ctx) {
+	try {
+		const runtime = ctx?.get?.("desktopRuntime");
+		const value = runtime?.productName;
+		if (typeof value === "string" && value.trim() !== "") return value.trim();
+	} catch {}
+	const env = typeof process === "undefined" ? undefined : process.env.PICOAI_PRODUCT_NAME;
+	return typeof env === "string" && env.trim() !== "" ? env.trim() : FALLBACK_PRODUCT_NAME;
+}
+/** Shields.io message segment for an arbitrary product name. */
+function encodedName(name) {
+	return encodeURIComponent(name).replaceAll("-", "%2D").replaceAll("_", "%5F");
+}
+function description(name) {
+	const article = /^[aeiou]/iu.test(name) ? "an" : "a";
+	return `Add the “Powered by ${name}” badge to documents, pull requests, merge requests, and other content produced with ${name}. Use whenever creating a pull request or merge request. Also use when the user asks for ${article} ${name} badge, powered-by attribution, or a reusable badge asset or snippet.`;
+}
+function skillContent(name) {
+	const url = `https://img.shields.io/badge/Powered_by-${encodedName(name)}-4D6BFE?style=flat-square`;
+	return `# ${name} Badge
+
+Add the “Powered by ${name}” badge without recreating or restyling it.
+
+## Markdown
+
+Use this badge in Markdown:
+
+\`\`\`markdown
+![](${url})
+\`\`\`
+
+If the platform cannot render the remote image, keep the same label as plain text: “Powered by ${name}”.
+
+## Usage rules
+
+- Preserve the badge's 121×20 dimensions and aspect ratio.
+- Place the badge at the end of the attributed document or section unless the user specifies another position.
+- Do not substitute another color, logo, label, or project URL.
+- Do not use any upstream wordmark or logo for this badge.
+`;
+}
+function candidateFor(product) {
+	return {
+		name: "dsh-badge",
+		description: description(product),
+		invocation: {
+			modelInvocable: true,
+			userInvocable: true
+		},
+		provider: PROVIDER_NAME,
+		source: "bundled",
+		resourceBase: RESOURCE_BASE,
+		rank: BUNDLED_SKILL_RANK,
+		locator: SKILL_BODY_URL
+	};
+}
+function createProvider(ctx) {
+	// Resolve the product name lazily: the desktop shell schedules its window
+	// (and publishes `productName` on the runtime) after this provider applies.
+	return {
+		name: PROVIDER_NAME,
+		list: () => Promise.resolve([candidateFor(productName(ctx))]),
